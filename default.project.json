{
  "name": "Snowball",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" }
    },
    "ServerScriptService": {
      "Server": { "$path": "src/server" }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": { "$path": "src/client" }
      }
    },
    "StarterGui": { "$path": "src/gui" },
    "Workspace": {
      "$path": "src/workspace",
      "$properties": {
        "StreamingEnabled": true,
        "StreamingTargetRadius": 640,
        "StreamingMinRadius": 128,
        "StreamOutBehavior": "Opportunistic"
      }
    },
    "Players": {
      "$properties": { "CharacterAutoLoads": false }
    },
    "Lighting": {
      "$properties": { "Technology": "Future", "GlobalShadows": true, "ClockTime": 13 }
    }
  }
}
